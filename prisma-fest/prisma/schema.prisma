// ─── PRISMA Fest Database Schema ─────────────────────────────────
// SQLite via Prisma ORM
// All models for the fest management platform

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Models ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("student")
  avatarUrl     String?   @map("avatar_url")
  studentId     String?   @map("student_id")
  isVerified    Boolean   @default(false) @map("is_verified")
  isBanned      Boolean   @default(false) @map("is_banned")
  verifyToken   String?   @map("verify_token")
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  events        Event[]         @relation("OrganizerEvents")
  registrations Registration[]
  notifications Notification[]
  feedback      Feedback[]
  announcements Announcement[]  @relation("AnnouncementAuthor")

  @@map("users")
}

model Event {
  id              String        @id @default(cuid())
  title           String
  description     String
  category        String        @default("other")
  venue           String
  date            DateTime
  time            String
  totalCapacity   Int           @map("total_capacity")
  registeredCount Int           @default(0) @map("registered_count")
  coverImage      String?       @map("cover_image")
  organizerId     String        @map("organizer_id")
  status          String        @default("upcoming")
  price           Float         @default(0)
  isFree          Boolean       @default(true) @map("is_free")
  isApproved      Boolean       @default(false) @map("is_approved")
  stripeProductId String?       @map("stripe_product_id")
  stripePriceId   String?       @map("stripe_price_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organizer     User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  registrations Registration[]
  schedule      FestSchedule[]
  feedback      Feedback[]

  @@index([status])
  @@index([category])
  @@index([date])
  @@index([organizerId])
  @@map("events")
}

model Registration {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  eventId         String        @map("event_id")
  ticketType      String        @default("general") @map("ticket_type")
  paymentStatus   String        @default("pending") @map("payment_status")
  paymentIntentId String?       @map("payment_intent_id")
  qrCode          String?       @map("qr_code")
  checkedIn       Boolean       @default(false) @map("checked_in")
  checkedInAt     DateTime?     @map("checked_in_at")
  registeredAt    DateTime      @default(now()) @map("registered_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([paymentStatus])
  @@map("registrations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   @default("general")
  eventId   String?  @map("event_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  priority    String               @default("normal")
  createdAt   DateTime             @default(now()) @map("created_at")
  createdById String               @map("created_by_id")

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  @@map("announcements")
}

model FestSchedule {
  id        String   @id @default(cuid())
  day       Int
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  title     String
  stage     String
  eventId   String?  @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([day])
  @@map("fest_schedule")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("feedback")
}

model Sponsor {
  id        String      @id @default(cuid())
  name      String
  logoUrl   String      @map("logo_url")
  tier      String
  website   String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("sponsors")
}
